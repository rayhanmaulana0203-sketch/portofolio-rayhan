---
---
<!-- SITE HEADER -->
<header class="site-header fixed top-0 left-0 w-full z-50 px-4 sm:px-6 lg:px-12 py-3.5 flex justify-between items-center transition-all duration-300">
    <a href="#home" class="site-logo text-xl font-extrabold tracking-tight flex items-center gap-1.5 flex-shrink-0" aria-label="Kembali ke Beranda">
        <span>Rayhan</span><span class="logo-accent">®</span>
    </a>

    <nav class="site-nav hidden md:flex items-center gap-6 lg:gap-8 font-medium text-sm" aria-label="Navigasi Utama">
        <a href="#home" class="nav-link">Beranda</a>
        <a href="#about" class="nav-link">Tentang</a>
        <a href="#education" class="nav-link">Pendidikan</a>
        <a href="#skills" class="nav-link">Keahlian</a>
        <a href="#projects" class="nav-link">Proyek</a>
        <a href="#contact" class="nav-contact-link">
            <span>Hubungi saya</span>
        </a>
    </nav>

    <button id="menu-btn" class="md:hidden p-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/5 transition flex items-center justify-center cursor-pointer" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-menu">
        <i id="menu-icon" data-lucide="menu" class="w-6 h-6"></i>
    </button>
</header>

<!-- MOBILE MENU DRAWER -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-x-0 z-40 px-6 py-6 flex flex-col gap-2 transition-all duration-300">
    <a href="#home" class="mobile-link">Beranda</a>
    <a href="#about" class="mobile-link">Tentang</a>
    <a href="#education" class="mobile-link">Pendidikan</a>
    <a href="#skills" class="mobile-link">Keahlian</a>
    <a href="#projects" class="mobile-link">Proyek</a>
    <a href="#contact" class="mobile-link-contact mt-3">
        <span>Hubungi saya</span>
    </a>
</div>
