---
import type { SkillCategory } from '../types';

const skills: SkillCategory[] = [
  {
    number: '01',
    title: 'UI/UX Design',
    description: 'Merancang antarmuka yang intuitif dengan wireframe dan prototipe untuk pengalaman pengguna yang lebih baik.',
    icon: 'layout',
    tags: ['Figma', 'Wireframing', 'Prototyping', 'Design Systems']
  },
  {
    number: '02',
    title: 'Frontend Development',
    description: 'Membangun tampilan web responsif dan interaktif, serta menjalankan server portfolio sederhana dengan Node.js.',
    icon: 'code-2',
    tags: ['HTML5', 'CSS3', 'Tailwind CSS', 'JavaScript', 'Node.js']
  },
  {
    number: '03',
    title: 'Soft Skills & Kolaborasi',
    description: 'Mengandalkan komunikasi aktif, problem solving, dan manajemen waktu saat bekerja secara mandiri maupun tim.',
    icon: 'users-round',
    tags: ['Problem Solving', 'Git & GitHub', 'Komunikasi Tim', 'Adaptabilitas']
  }
];
---

<!-- SKILLS SECTION -->
<section id="skills" class="reveal-section content-section px-4 sm:px-6 lg:px-12 py-20 border-t border-white/5">
    <div class="max-w-7xl mx-auto">
        <div class="section-heading">
            <div>
                <span class="section-index">03 · Kemampuan</span>
                <h2>Keahlian</h2>
            </div>
            <p>Kemampuan teknis dan dasar perancangan yang saya kuasai.</p>
        </div>

        <div class="skills-grid">
            {skills.map((skill) => (
                <article class="skill-card">
                    <div class="skill-card-top">
                        <div class="skill-icon">
                            <i data-lucide={skill.icon} class="w-6 h-6" aria-hidden="true"></i>
                        </div>
                        <span class="skill-number">{skill.number}</span>
                    </div>
                    <h3>{skill.title}</h3>
                    <p>{skill.description}</p>
                    <div class="skill-tags" aria-label={`Keahlian ${skill.title}`}>
                        {skill.tags.map((tag) => (
                            <span>{tag}</span>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
