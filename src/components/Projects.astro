---
import type { ProjectItem } from '../types';

const projects: ProjectItem[] = [
  {
    id: 'ecommerce',
    title: 'Website E-Commerce Toko Buah',
    description: 'Halaman toko buah dengan katalog produk, navigasi kategori, dan area promosi untuk pengalaman belanja online yang nyaman.',
    tags: {
      accent: 'Tailwind CSS',
      muted: ['JavaScript', 'Responsive']
    },
    image: '/images/Website E Commerce.png',
    imageAlt: 'Tampilan halaman utama toko buah dengan katalog produk',
    previewNote: 'Live Preview segera hadir',
    githubUrl: 'https://github.com/rayhanmaulana0203-sketch'
  },
  {
    id: 'math-ceria',
    title: 'Math Ceria: Belajar Matematika',
    description: 'Website edukasi yang mengajak siswa belajar matematika dengan suasana menyenangkan, dilengkapi navigasi materi interaktif.',
    tags: {
      accent: 'Edukasi',
      muted: ['Matematika', 'Web Interaktif']
    },
    image: '/images/math-ceria-preview.png',
    imageAlt: 'Pratinjau website Math Ceria untuk belajar matematika dengan cara menyenangkan',
    previewNote: 'Konsep proyek cadangan',
    githubUrl: 'https://github.com/rayhanmaulana0203-sketch'
  },
  {
    id: 'wisata',
    title: 'Website Panduan Wisata',
    description: 'Konsep website panduan destinasi wisata dengan informasi tempat, rekomendasi aktivitas, dan tampilan ramah perangkat seluler.',
    tags: {
      accent: 'JavaScript',
      muted: ['Responsive', 'Eksplorasi']
    },
    isPlaceholder: true,
    placeholderTitle: 'Konsep Eksplorasi',
    previewNote: 'Konsep eksplorasi',
    githubUrl: 'https://github.com/rayhanmaulana0203-sketch'
  }
];
---

<!-- PROJECTS SECTION -->
<section id="projects" class="reveal-section content-section px-4 sm:px-6 lg:px-12 py-20 border-t border-white/5">
    <div class="max-w-7xl mx-auto">
        <div class="section-heading">
            <div>
                <span class="section-index">04 · Portofolio</span>
                <h2>Proyek Pilihan</h2>
            </div>
            <p>Tiga proyek pilihan untuk memperlihatkan eksplorasi dan karya saya.</p>
        </div>

        <div class="project-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {projects.map((project) => (
                <article class="project-card flex flex-col rounded-2xl overflow-hidden group">
                    {project.isPlaceholder ? (
                        <div class="project-image project-placeholder" aria-hidden="true">
                            <div class="placeholder-graphic">
                                <i data-lucide="compass" class="w-12 h-12"></i>
                                <span>{project.placeholderTitle}</span>
                            </div>
                        </div>
                    ) : (
                        <div class="project-image">
                            <img src={project.image} alt={project.imageAlt} loading="lazy" />
                        </div>
                    )}
                    <div class="project-content p-6 flex flex-col justify-between flex-1">
                        <div>
                            <div class="project-tags flex flex-wrap gap-2 mb-3.5">
                                <span class="tag-accent">{project.tags.accent}</span>
                                {project.tags.muted.map((tag) => (
                                    <span class="tag-muted">{tag}</span>
                                ))}
                            </div>
                            <h3 class="project-title text-xl sm:text-2xl font-bold mb-2.5 transition">
                                {project.title}
                            </h3>
                            <p class="project-desc text-gray-400 text-sm mb-6 leading-relaxed">
                                {project.description}
                            </p>
                        </div>
                        <div class="project-footer flex flex-wrap items-center gap-3 mt-auto pt-4 border-t border-white/5">
                            <span class="project-preview-pending">{project.previewNote}</span>
                            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="project-action-primary">
                                <span>Lihat GitHub</span>
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
