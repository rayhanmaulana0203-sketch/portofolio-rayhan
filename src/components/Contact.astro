---
import type { SocialLink } from '../types';

const socialLinks: SocialLink[] = [
  {
    platform: 'GitHub',
    url: 'https://github.com/rayhanmaulana0203-sketch',
    description: 'Repositori & kode sumber',
    icon: 'code-2',
    ariaLabel: 'Profil GitHub Rayhan'
  },
  {
    platform: 'LinkedIn',
    url: 'https://linkedin.com/in/muhamad-rayhan-maulana-743b47363',
    description: 'Jaringan & profil profesional',
    icon: 'briefcase-business',
    ariaLabel: 'Profil LinkedIn Rayhan'
  }
];
---

<!-- CONTACT SECTION -->
<section id="contact" class="reveal-section content-section px-4 sm:px-6 lg:px-12 py-20 md:py-28 border-t border-white/5">
    <div class="contact-layout max-w-7xl mx-auto">
        <div class="contact-copy">
            <span class="section-eyebrow">05 · Kontak</span>
            <h2 class="contact-title text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-5">
                Yuk, buat sesuatu <span class="highlight-text">yang hebat</span> bersama.
            </h2>
            <p class="contact-intro text-gray-400 text-base md:text-lg mb-8 leading-relaxed">
                Punya ide proyek, peluang magang, atau ingin berdiskusi tentang teknologi web? Saya terbuka untuk terhubung.
            </p>

            <div class="contact-email">
                <a id="email-btn" href="mailto:rayhanmaulana0203@gmail.com" aria-label="Kirim email ke rayhanmaulana0203@gmail.com" class="email-address-link">
                    <i data-lucide="mail" class="w-5 h-5 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">rayhanmaulana0203@gmail.com</span>
                </a>
                <div class="contact-email-actions">
                    <button id="copy-email-btn" type="button" class="btn-copy">
                        <i data-lucide="copy" class="w-4 h-4" aria-hidden="true"></i>
                        <span id="copy-btn-text">Salin</span>
                    </button>
                    <a class="contact-send" href="mailto:rayhanmaulana0203@gmail.com">
                        <i data-lucide="send" class="w-4 h-4" aria-hidden="true"></i>
                        <span>Kirim Email</span>
                    </a>
                </div>
            </div>

            <p id="toast" class="contact-status hidden" role="status" aria-live="polite">
                <i data-lucide="check" class="w-4 h-4 inline-block mr-1 text-lime-400"></i>
                <span>Email berhasil disalin ke clipboard!</span>
            </p>

            <p class="contact-response">
                <span class="status-indicator" aria-hidden="true"></span>
                <span>Biasanya membalas dalam 24 jam</span>
            </p>
        </div>

        <div class="social-grid grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Profil sosial">
            {socialLinks.map((item) => (
                <a class="social-card" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.ariaLabel}>
                    <div class="social-card-header">
                        <span class="social-icon"><i data-lucide={item.icon} class="w-5 h-5" aria-hidden="true"></i></span>
                        <i data-lucide="arrow-up-right" class="social-arrow w-4 h-4" aria-hidden="true"></i>
                    </div>
                    <strong class="social-platform">{item.platform}</strong>
                    <span class="social-description">{item.description}</span>
                </a>
            ))}
        </div>
    </div>
</section>
