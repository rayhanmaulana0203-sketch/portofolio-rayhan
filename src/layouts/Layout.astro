---
import '../styles/main.scss';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muhamad Rayhan Maulana | Portofolio",
  description = "Portofolio Muhamad Rayhan Maulana, mahasiswa Teknik Informatika yang tertarik pada web development dan UI/UX."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#0b0e14">
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>
</head>
<body>
    <canvas id="bg-canvas" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <div class="ambient-glow" aria-hidden="true"></div>

    <slot />

    <script>
      import '../scripts/main.ts';
    </script>
</body>
</html>
